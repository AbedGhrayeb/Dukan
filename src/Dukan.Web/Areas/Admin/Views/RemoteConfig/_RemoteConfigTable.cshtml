@using Dukan.Web.Application.DTOs.RemoteConfig
@model RemoteConfigTemplateDto

@if (Model.Parameters.Count == 0)
{
    <div class="alert alert-info mb-0">لا توجد معاملات في Remote Config. أنشئ أول مفتاح باستخدام زر "إضافة مفتاح".</div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>المفتاح</th>
                        <th>القيمة</th>
                        <th>النوع</th>
                        <th>الوصف</th>
                        <th style="width: 140px;">إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Parameters)
                    {
                        <tr>
                            <td><code class="bg-light px-1 rounded">@p.Key</code></td>
                            <td style="max-width: 320px;">
                                <span class="text-break" title="@p.Value">@(p.Value.Length > 120 ? p.Value.Substring(0, 120) + "..." : p.Value)</span>
                            </td>
                            <td><span class="badge bg-secondary">@p.ValueType</span></td>
                            <td class="text-muted small">@p.Description</td>
                            <td>
                                <div class="d-flex gap-1">
                                    <button type="button" class="btn btn-sm btn-outline-primary js-rc-edit" data-key="@p.Key" title="تعديل">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger js-rc-delete" data-key="@p.Key" title="حذف">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
