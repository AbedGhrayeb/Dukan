@model PagedResult<SubscriptionDto>
@{
    ViewData["Title"] = "طلبات الاشتراك";
    var currentStatus = ViewData["StatusFilter"] as SubscriptionStatus?;
}

@if (Model.Items.Count == 0)
{
    <div class="text-center py-4">
        <i class="bi bi-inbox display-4 text-body-tertiary"></i>
        <p class="mt-2 text-body-secondary small">لا توجد طلبات بهذه الحالة.</p>
    </div>
}
else
{
    <div class="card shadow-sm border-0">
        <div class="table-responsive plans-table-scroll">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="py-2">العميل</th>
                        <th class="py-2">المتجر</th>
                        <th class="py-2 text-center">الهاتف</th>
                        <th class="py-2 text-center">الواتساب</th>
                        <th class="py-2">الخطة</th>
                        <th class="py-2">التاريخ</th>
                        <th class="py-2 text-center">الحالة</th>
                        <th class="py-2"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var request in Model.Items)
                    {
                        <tr>
                            <td class="py-1 fw-semibold">@request.CustomerName</td>
                            <td class="py-1 fw-semibold text-primary">@request.CustomerStoreName</td>
                            <td class="py-1 text-center" dir="ltr">@request?.CustomerPhone</td>
                            <td class="py-1 text-center" dir="ltr">@request?.CustomerWhatsAppNumber</td>
                            <td class="py-1">@request?.PlanName</td>
                            <td class="py-1">@request?.RequestAt</td>
                            <td class="py-1 text-center"><span class="badge @StatusDisplay.GetBadgeClass(request!.Status)">@request.StatusDisplay</span></td>
                            <td class="py-1">
                                <a class="btn btn-sm btn-outline-primary py-0 px-2" asp-area="Admin" asp-controller="Requests" asp-action="Details" asp-route-id="@request.Id">عرض</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="صفحات الطلبات" class="mt-2">
            <ul class="pagination pagination-sm justify-content-center mb-0">
                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link py-1"
                           asp-area="Admin" asp-controller="Requests" asp-action="Index"
                           asp-route-status="@currentStatus" asp-route-page="@i">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
}
