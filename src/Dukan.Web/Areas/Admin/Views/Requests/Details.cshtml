@model SubscriptionDto
@{
    ViewData["Title"] = "تفاصيل الطلب";
    var canAct = Model.Status == SubscriptionStatus.Pending;
    var hasFirebase = ViewData["HasFirebase"] as bool? ?? false;
    var initials = string.IsNullOrWhiteSpace(Model.CustomerName) ? "?" : string.Join("", Model.CustomerName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => s[0])).ToUpperInvariant();
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb mb-0 small">
        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="text-decoration-none">لوحة التحكم</a></li>
        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Requests" asp-action="Index" class="text-decoration-none">طلبات الاشتراك</a></li>
        <li class="breadcrumb-item active" aria-current="page">تفاصيل الطلب</li>
    </ol>
</nav>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
        <h1 class="h4 mb-1 d-flex align-items-center gap-2">
            <span class="d-inline-flex align-items-center justify-content-center rounded-3 bg-primary bg-opacity-10" style="width:2.5rem;height:2.5rem;">
                <i class="bi bi-inbox text-primary fs-5" aria-hidden="true"></i>
            </span>
            تفاصيل الطلب
            <span class="badge @StatusDisplay.GetBadgeClass(Model.Status) fs-6 fw-normal">@StatusDisplay.GetLabel(Model.Status)</span>
        </h1>
        <div class="text-body-secondary small d-flex flex-wrap gap-2 align-items-center">
            <span><i class="bi bi-hash me-1"></i>@Model.Id.ToString()[..8]…</span>
            <span class="vr"></span>
            <span><i class="bi bi-calendar-event me-1"></i>@Model.RequestAt</span>
        </div>
    </div>
    <a class="btn btn-outline-secondary btn-sm" asp-area="Admin" asp-controller="Requests" asp-action="Index">
        <i class="bi bi-arrow-right me-1" aria-hidden="true"></i> رجوع للقائمة
    </a>
</div>

@if (canAct && !hasFirebase)
{
    <div class="alert alert-warning border-warning d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3 py-3 shadow-sm mb-4" role="alert">
        <div class="d-flex gap-3">
            <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-warning bg-opacity-25 flex-shrink-0" style="width:2.75rem;height:2.75rem;">
                <i class="bi bi-exclamation-triangle text-warning fs-5" aria-hidden="true"></i>
            </span>
            <div>
                <h2 class="h6 mb-1">التفعيل يتطلب تهيئة Firebase</h2>
                <p class="mb-0 small text-body-secondary">يجب ربط مشروع Firebase لهذا الاشتراك قبل التفعيل. كل اشتراك يملك مشروع Firebase منفصل — سيتم إنشاء <code>is_active</code> وتواريخ الاشتراك تلقائياً عند النشر.</p>
            </div>
        </div>
        <a asp-area="Admin" asp-controller="FirebaseConfig" asp-action="Index" asp-route-subscriptionId="@Model.Id" class="btn btn-warning flex-shrink-0">
            <i class="bi bi-gear me-1" aria-hidden="true"></i> تهيئة Firebase للاشتراك
        </a>
    </div>
}

<div class="row g-4">
    <!-- Customer & Plan -->
    <div class="col-12 col-xl-8">
        <div class="card border-0 shadow-sm mb-4 overflow-hidden">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <h2 class="h6 mb-0 d-flex align-items-center gap-2">
                    <i class="bi bi-person-circle text-primary" aria-hidden="true"></i> بيانات العميل
                </h2>
                <a asp-area="Admin" asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId" class="btn btn-sm btn-outline-primary">
                    عرض العميل <i class="bi bi-box-arrow-up-left ms-1" aria-hidden="true"></i>
                </a>
            </div>
            <div class="card-body p-4">
                <div class="d-flex gap-3 mb-4">
                    <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary text-white fw-bold flex-shrink-0" style="width:3.5rem;height:3.5rem;font-size:1.15rem;">@initials</span>
                    <div class="flex-grow-1 min-w-0">
                        <div class="fw-bold fs-5 lh-sm text-truncate">@Model.CustomerName</div>
                        <div class="d-flex align-items-center gap-1 text-primary fw-semibold">
                            <i class="bi bi-shop small" aria-hidden="true"></i> @Model.CustomerStoreName
                        </div>
                        <div class="d-flex flex-wrap gap-2 mt-2">
                            <a href="tel:@Model.CustomerPhone" class="btn btn-sm btn-outline-secondary" dir="ltr">
                                <i class="bi bi-telephone me-1" aria-hidden="true"></i>@Model.CustomerPhone
                            </a>
                            <a href="https://wa.me/@Model.CustomerWhatsAppNumber" target="_blank" rel="noopener" class="btn btn-sm btn-success" dir="ltr">
                                <i class="bi bi-whatsapp me-1" aria-hidden="true"></i>@Model.CustomerWhatsAppNumber
                            </a>
                        </div>
                    </div>
                    <span class="badge @(hasFirebase ? "bg-success" : "bg-warning text-dark") align-self-start">
                        <i class="bi @(hasFirebase ? "bi-check-circle" : "bi-exclamation-circle") me-1" aria-hidden="true"></i>@(hasFirebase ? "Firebase مُهيأ" : "Firebase غير مُهيأ")
                    </span>
                </div>

                <div class="row g-3 small">
                    <div class="col-6 col-md-4">
                        <div class="text-body-secondary">رقم الطلب</div>
                        <div class="font-monospace fw-semibold text-truncate" title="@Model.Id">@Model.Id.ToString()[..8]</div>
                    </div>
                    <div class="col-6 col-md-4">
                        <div class="text-body-secondary">تاريخ الطلب</div>
                        <div class="fw-semibold">@Model.RequestAt</div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="text-body-secondary">الحالة</div>
                        <span class="badge @StatusDisplay.GetBadgeClass(Model.Status)">@StatusDisplay.GetLabel(Model.Status)</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.AdminNotes))
                    {
                        <div class="col-12">
                            <div class="bg-light rounded-3 p-3 border">
                                <div class="text-body-secondary small mb-1"><i class="bi bi-sticky me-1"></i>ملاحظات الطلب</div>
                                <div class="mb-0">@Model.AdminNotes</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom py-3">
                <h2 class="h6 mb-0 d-flex align-items-center gap-2">
                    <i class="bi bi-tags text-primary" aria-hidden="true"></i> الخطة المطلوبة
                </h2>
            </div>
            <div class="card-body p-4">
                <div class="d-flex gap-3 align-items-start">
                    <span class="d-inline-flex align-items-center justify-content-center rounded-3 bg-primary bg-opacity-10 flex-shrink-0" style="width:3rem;height:3rem;">
                        <i class="bi bi-box-seam text-primary fs-5" aria-hidden="true"></i>
                    </span>
                    <div class="flex-grow-1">
                        <div class="fw-bold fs-6">@Model.PlanName</div>
                        <div class="text-body-secondary small">
                            @if (!string.IsNullOrWhiteSpace(Model.DurationLable)) { <span><i class="bi bi-clock me-1"></i>@Model.DurationLable</span> }
                            @if (!string.IsNullOrWhiteSpace(Model.DisplayPrice)) { <span class="mx-2">•</span> <span><i class="bi bi-currency-exchange me-1"></i>@Model.DisplayPrice</span> }
                        </div>
                    </div>
                </div>
                <div class="alert alert-info bg-info bg-opacity-10 border-info border-opacity-25 mt-3 mb-0 small py-2">
                    <i class="bi bi-info-circle me-1" aria-hidden="true"></i> عند التفعيل سيُنشأ في Firebase: <code>is_active=true</code>، <code>subscription_start_date</code>، <code>subscription_end_date</code>.
                </div>
            </div>
        </div>
    </div>

    <!-- Actions -->
    <div class="col-12 col-xl-4">
        <div class="card border-0 shadow-sm sticky-xl-top" style="top:1rem;">
            <div class="card-body p-4">
                @if (canAct)
                {
                    <h2 class="h6 mb-3">إجراءات الطلب</h2>
                    <p class="text-body-secondary small mb-3">اختر إجراءً. التفعيل سينقلك لصفحة Remote Config لنشر القيم ثم تفعيل الاشتراك تلقائياً.</p>

                    <div class="d-grid gap-2">
                        <form method="post" asp-area="Admin" asp-controller="Requests" asp-action="Approve" asp-route-id="@Model.Id" data-confirm="approve">
                            <button type="submit" class="btn btn-success w-100 py-2 d-flex align-items-center justify-content-center gap-2" disabled="@(!hasFirebase ? "disabled" : null)" title="@(!hasFirebase ? "يجب تهيئة Firebase أولاً" : "تفعيل عبر Remote Config")">
                                <i class="bi bi-lightning-charge-fill" aria-hidden="true"></i>
                                <span>تفعيل الطلب</span>
                                <i class="bi bi-arrow-left small" aria-hidden="true"></i>
                            </button>
                        </form>
                        @if (!hasFirebase)
                        {
                            <div class="text-center">
                                <a asp-area="Admin" asp-controller="FirebaseConfig" asp-action="Index" asp-route-subscriptionId="@Model.Id" class="small text-decoration-none">تهيئة Firebase للاشتراك الآن ←</a>
                            </div>
                        }
                        <hr class="my-2" />
                        <form method="post" asp-area="Admin" asp-controller="Requests" asp-action="Reject" asp-route-id="@Model.Id" data-confirm="reject">
                            <button type="submit" class="btn btn-outline-danger w-100">
                                <i class="bi bi-x-lg me-1" aria-hidden="true"></i> رفض الطلب
                            </button>
                        </form>
                        <form method="post" asp-area="Admin" asp-controller="Requests" asp-action="Cancel" asp-route-id="@Model.Id" data-confirm="cancel">
                            <button type="submit" class="btn btn-outline-secondary w-100">
                                <i class="bi bi-slash-circle me-1" aria-hidden="true"></i> إلغاء الطلب
                            </button>
                        </form>
                    </div>

                    <div class="bg-light rounded-3 p-3 mt-4 small">
                        <div class="fw-semibold mb-2"><i class="bi bi-question-circle me-1"></i>ماذا يحدث عند التفعيل؟</div>
                        <ol class="mb-0 ps-3">
                            <li>الانتقال لصفحة Remote Config للاشتراك</li>
                            <li>إضافة <code>is_active</code> والتواريخ افتراضياً لهذا الاشتراك</li>
                            <li>النشر → تفعيل الاشتراك تلقائياً</li>
                        </ol>
                    </div>
                }
                else
                {
                    <div class="text-center py-2">
                        <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-secondary bg-opacity-10 mb-3" style="width:3rem;height:3rem;">
                            <i class="bi @(Model.Status == SubscriptionStatus.Active ? "bi-check2-circle text-success" : Model.Status == SubscriptionStatus.Rejected ? "bi-x-circle text-danger" : "bi-info-circle text-secondary") fs-4" aria-hidden="true"></i>
                        </span>
                        <h2 class="h6 mb-1">الطلب @StatusDisplay.GetLabel(Model.Status)</h2>
                        <p class="text-body-secondary small mb-3">هذا الطلب تمّت معالجته ولا يمكن اتخاذ إجراء إضافي.</p>
                        <a asp-area="Admin" asp-controller="Requests" asp-action="Index" class="btn btn-outline-secondary btn-sm w-100">العودة للقائمة</a>
                    </div>
                    <hr />
                    <div class="d-grid gap-2">
                        <a asp-area="Admin" asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-person me-1"></i> عرض العميل
                        </a>
                        <a asp-area="Admin" asp-controller="Subscriptions" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-badge-check me-1"></i> عرض الاشتراكات
                        </a>
                    </div>
                }
            </div>
        </div>

        <div class="card border-0 shadow-sm mt-4">
            <div class="card-body p-3 small">
                <div class="d-flex justify-content-between">
                    <span class="text-body-secondary">معرّف العميل</span>
                    <span class="font-monospace" title="@Model.CustomerId">@Model.CustomerId.ToString()[..8]…</span>
                </div>
                <hr class="my-2" />
                <div class="d-flex justify-content-between">
                    <span class="text-body-secondary">Firebase</span>
                    <span class="badge @(hasFirebase ? "bg-success" : "bg-warning text-dark")">@(hasFirebase ? "مُهيأ" : "غير مُهيأ")</span>
                </div>
            </div>
        </div>
    </div>
</div>
