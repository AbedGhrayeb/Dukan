@model PagedResult<SubscriptionDto>
@{
    ViewData["Title"] = "الاشتراكات";
    var currentStatus = ViewData["StatusFilter"] as SubscriptionStatus?;
    var hasFirebaseMap = ViewData["HasFirebaseMap"] as Dictionary<Guid, bool>;
}

<div class="d-flex flex-wrap gap-2 mb-3">
    <a class="btn btn-sm @(currentStatus is null ? "btn-primary" : "btn-outline-primary")"
       asp-area="Admin" asp-controller="Subscriptions" asp-action="Index">الكل</a>
    @foreach (var status in Enum.GetValues<SubscriptionStatus>())
    {
        <a class="btn btn-sm @(currentStatus == status ? "btn-primary" : "btn-outline-primary")"
           asp-area="Admin" asp-controller="Subscriptions" asp-action="Index" asp-route-status="@status">
            @StatusDisplay.GetLabel(status)
        </a>
    }
</div>

@if (Model.Items.Count == 0)
{
    <div class="alert alert-info">لا توجد اشتراكات بهذه الحالة.</div>
}
else
{
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>العميل</th>
                        <th>المتجر</th>
                        <th>الخطة</th>
                        <th>يبدأ</th>
                        <th>ينتهي</th>
                        <th>الحالة</th>
                        <th>Firebase</th>
                        <th style="width: 120px;">إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var subscription in Model.Items)
                    {
                        var hasFirebase = hasFirebaseMap != null && hasFirebaseMap.ContainsKey(subscription.Id);
                        <tr>
                            <td>@(subscription.CustomerName ?? "")</td>
                            <td class="fw-semibold text-primary">@(subscription.CustomerStoreName ?? "")</td>
                            <td>@(subscription.PlanName ?? "")</td>
                            <td class="small">@(subscription.StartDate ?? "-")</td>
                            <td class="small">@(subscription.EndDate ?? "-")</td>
                            <td><span class="badge @StatusDisplay.GetBadgeClass(subscription.Status)">@StatusDisplay.GetLabel(subscription.Status)</span></td>
                            <td>
                                @if (hasFirebase)
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> مُهيأ</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark"><i class="bi bi-exclamation-triangle me-1"></i> غير مُهيأ</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex gap-1 flex-nowrap action-btns">
                                    <a class="btn btn-sm btn-outline-primary" asp-area="Admin" asp-controller="Subscriptions" asp-action="Details" asp-route-id="@subscription.Id" title="عرض">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a class="btn btn-sm @(hasFirebase ? "btn-outline-secondary" : "btn-warning")" asp-area="Admin" asp-controller="FirebaseConfig" asp-action="Index" asp-route-subscriptionId="@subscription.Id" title="تهيئة Firebase">
                                        <i class="bi bi-gear"></i>
                                    </a>
                                    <a class="btn btn-sm btn-outline-secondary" asp-area="Admin" asp-controller="RemoteConfig" asp-action="Index" asp-route-subscriptionId="@subscription.Id" title="إعدادات التطبيق">
                                        <i class="bi bi-sliders"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <nav aria-label="صفحات الاشتراكات" class="mt-3">
        <ul class="pagination justify-content-center">
            @for (var i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link"
                       asp-area="Admin" asp-controller="Subscriptions" asp-action="Index"
                       asp-route-status="@currentStatus" asp-route-page="@i">@i</a>
                </li>
            }
        </ul>
    </nav>
}
