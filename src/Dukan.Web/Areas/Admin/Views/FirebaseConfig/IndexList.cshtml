@using Dukan.Web.Application.Interfaces
@model IReadOnlyList<FirebaseConfigListItemDto>
@{
    ViewData["Title"] = "تهيئة Firebase - الاشتراكات";
    var search = ViewData["Search"] as string;
}
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" asp-area="Admin" asp-controller="FirebaseConfig" asp-action="Index" class="d-flex gap-2">
            <input type="text" name="search" value="@search" class="form-control" placeholder="بحث بالاسم، المتجر، الهاتف أو الخطة..." style="max-width: 320px;" />
            <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-search me-1"></i> بحث</button>
            <a href="@Url.Action("Index", "FirebaseConfig", new { area = "Admin" })" class="btn btn-outline-secondary">عرض الكل</a>
        </form>
        <div class="form-text">كل اشتراك يملك مشروع Firebase منفصل — <code>project_id</code> يجب أن يكون فريد.</div>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">لا يوجد اشتراكات مطابقة.</div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>العميل</th>
                        <th>المتجر</th>
                        <th>الهاتف</th>
                        <th>الخطة</th>
                        <th>الحالة</th>
                        <th>Firebase</th>
                        <th>Project ID</th>
                        <th>آخر تحديث</th>
                        <th>إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.CustomerName</td>
                            <td class="fw-semibold text-primary">@item.StoreName</td>
                            <td dir="ltr">@item.Phone</td>
                            <td><span class="badge bg-light text-dark border">@item.PlanName</span></td>
                            <td><span class="badge bg-secondary">@item.Status</span></td>
                            <td>
                                @if (item.HasConfig)
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> مُهيأ</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark"><i class="bi bi-exclamation-triangle me-1"></i> غير مُهيأ</span>
                                }
                            </td>
                            <td><code>@(item.ProjectId ?? "-")</code></td>
                            <td class="small text-muted">@(item.UpdatedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                            <td>
                                <div class="d-flex gap-1">
                                    <a asp-area="Admin" asp-controller="FirebaseConfig" asp-action="Index" asp-route-subscriptionId="@item.SubscriptionId" class="btn btn-sm @(item.HasConfig ? "btn-outline-primary" : "btn-primary")">
                                        <i class="bi bi-gear me-1"></i> @(item.HasConfig ? "تعديل" : "تهيئة")
                                    </a>
                                    <a asp-area="Admin" asp-controller="RemoteConfig" asp-action="Index" asp-route-subscriptionId="@item.SubscriptionId" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-sliders me-1"></i> Remote Config
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
