@model Dukan.Web.Areas.Admin.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "تسجيل الدخول";
    Layout = "_Layout";
}

<section class="section bg-green-50">
    <div class="container" style="max-width: 26rem;">
        <div class="text-center mb-4">
            <span class="brand-mark" aria-hidden="true">د</span>
            <h1 class="section-title mt-3">تسجيل دخول المدير</h1>
            <p class="text-body-secondary">لوحة تحكم دكان</p>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <form method="post" asp-area="Admin" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none"></div>

                    @if (ViewData.ModelState[string.Empty] is { Errors.Count: > 0 } errorState)
                    {
                        <div class="alert alert-danger" role="alert">
                            @string.Join(" ", errorState.Errors.Select(e => e.ErrorMessage))
                        </div>
                    }

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" dir="ltr" autocomplete="username" />
                        <span asp-validation-for="Email" class="field-validation-error"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" dir="ltr" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="field-validation-error"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label"></label>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg">دخول</button>
                    </div>
                </form>
            </div>
        </div>

        <p class="text-center text-body-secondary small mt-4">
            <a asp-controller="Home" asp-action="Index">العودة إلى الموقع</a>
        </p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
