            <div class="col-12 col-md-6 col-lg-4 col-xl-3">
                <article class="feature-card">
                    <span class="feature-icon"><i class="bi bi-clipboard-data" aria-hidden="true"></i></span>
                    <h3>الجرد</h3>
                    <ul class="feature-list">
                        <li><i class="bi bi-check2" aria-hidden="true"></i> جلسة جرد لكل رفّ أو ثلاجة</li>
                        <li><i class="bi bi-check2" aria-hidden="true"></i> العد بالمسح أو اليد أو الوزن</li>
                        <li><i class="bi bi-check2" aria-hidden="true"></i> مراجعة الفروقات قبل الاعتماد</li>
                    </ul>
                    <p class="feature-callout mb-0">بدون تسكير المحل - والبيع أثناء الجرد.</p>
                </article>
            </div>

            <div class="col-12 col-md-6 col-lg-4 col-xl-3">
                <article class="feature-card">
                    <span class="feature-icon"><i class="bi bi-arrow-repeat" aria-hidden="true"></i></span>
                    <h3>المزامنة</h3>
                    <ul class="feature-list">
                        <li><i class="bi bi-check2" aria-hidden="true"></i> العمل بدون انترنت</li>
                        <li><i class="bi bi-check2" aria-hidden="true"></i> المزامنة تلقائية عند عودة الاتصال/li>
                        <li><i class="bi bi-check2" aria-hidden="true"></i> عدة أجهزة وبيانات موحدة</li>
                    </ul>
                    <p class="feature-callout mb-3">المحل واحد ولو تعددت الأجهزة.</p>
                </article>
            </div>

            <div class="col-12 col-md-6 col-lg-4 col-xl-3">
                <article class="feature-card">
                    <span class="feature-icon"><i class="bi bi-shield-check" aria-hidden="true"></i></span>
                    <h3>الحماية من الخطأ البشري</h3>
                    <ul class="feature-list">
                        <li><i class="bi bi-check2" aria-hidden="true"></i> سلة المحذوفات واسترجاع البيانات</li>
                        <li><i class="bi bi-check2" aria-hidden="true"></i> التراجع عن دمج الأصناف</li>
                        <li><i class="bi bi-check2" aria-hidden="true"></i> تسجيل من أنشأ وعدّل ووقت التعديل</li>
                        <li><i class="bi bi-check2" aria-hidden="true"></i> خيارات حذف الحركة أو عكس أثرها على المخزون</li>
                    </ul>
                    <p class="feature-callout mb-0">تحكم كامل في عمليات المتجر.</p>
                </article>
            </div>
        </div>
    </div>
</section>

<!-- Pricing (from database) -->
<section class="section pricing-section" id="pricing" aria-labelledby="pricing-title">
    <div class="container">
        <p class="section-kicker">الأسعار</p>
        <h2 class="section-title" id="pricing-title">خطط بسيطة تناسب محلّك</h2>
        <p class="section-sub mb-4">اختر خطتك وابدأ. الأسعار قابلة للتعديل من لوحة التحكم.</p>
        @if (plans.Count == 0)
        {
            <p class="text-body-secondary text-center">الخطط متاحة قريباً. تواصل معنا عبر واتساب للتفاصيل.</p>
        }
        else
        {
            <div class="row g-4 justify-content-center">
                @foreach (var plan in plans)
                {
                    var featured = plan.IsTrial || plan == plans[0];
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="price-card @(featured ? "featured" : "")">
                            <span class="plan-name">@plan.Name</span>
                            <span class="plan-duration">@Dukan.Web.Application.Display.DurationDisplay.Format(plan.Duration, plan.DurationUnit)</span>
                            <div class="plan-price">
                                @if (plan.IsTrial || plan.Price == 0)
                                {
                                    <span>مجاني</span>
                                }
                                else
                                {
                                    <span>@plan.Price.ToString("0.##") @plan.Currency</span>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(plan.Description))
                            {
                                    <p class="plan-desc feature-callout mb-0">@plan.Description</p>
                            }
                            <a class="btn @(featured ? "btn-primary" : "btn-outline-primary") mt-3" asp-controller="Subscription" asp-action="Index">اختر خطتك</a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

<!-- Subscribe: form + what happens after -->
<section class="section bg-green-50" id="subscribe" aria-labelledby="subscribe-title">
    <div class="container">
        <div class="row g-5 align-items-center">

            <!-- Form (right in RTL) -->
            <div class="col-12 col-lg-6">
                <p class="section-kicker text-center">اشترك الآن</p>
                <h2 class="section-title text-center" id="subscribe-title">اطلب اشتراكك الآن</h2>
                <p class="section-sub mx-auto text-center mb-4">املأ النموذج وسنتواصل معك عبر واتساب لإكمال الإجراءات.</p>

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty] is { Errors.Count: > 0 } errorState)
                {
                    <div class="alert alert-danger" role="alert">
                        @string.Join(" ", errorState.Errors.Select(e => e.ErrorMessage))
                    </div>
                }

                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">
                        <form method="post" asp-controller="Subscription" asp-action="Index">
                            <div asp-validation-summary="ModelOnly" class="text-danger d-none"></div>

                            <div class="mb-3">
                                <label asp-for="FullName" class="form-label">الاسم الكامل *</label>
                                <input asp-for="FullName" class="form-control" placeholder="مثال: أحمد محمد" autocomplete="name" />
                                <span asp-validation-for="FullName" class="field-validation-error"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="StoreName" class="form-label">اسم المتجر *</label>
                                <input asp-for="StoreName" class="form-control" placeholder="مثال: سوبرماركت الأمانة" />
                                <span asp-validation-for="StoreName" class="field-validation-error"></span>
                            </div>

                            <div class="row g-3">
                                <div class="col-12 col-sm-6">
                                    <label asp-for="Phone" class="form-label">رقم الهاتف *</label>
                                    <input asp-for="Phone" class="form-control" placeholder="مثال: 0555123456" dir="ltr" autocomplete="tel" inputmode="tel" />
                                    <span asp-validation-for="Phone" class="field-validation-error"></span>
                                </div>
                                <div class="col-12 col-sm-6">
                                    <label asp-for="WhatsAppNumber" class="form-label">رقم الواتساب *</label>
                                    <input asp-for="WhatsAppNumber" class="form-control" placeholder="مثال: 0555123456" dir="ltr" autocomplete="tel" inputmode="tel" />
                                    <span asp-validation-for="WhatsAppNumber" class="field-validation-error"></span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="PlanId" class="form-label">الخطة المطلوبة *</label>
                                <select asp-for="PlanId" class="form-select" required>
                                    <option value="">اختر الخطة…</option>
                                    @foreach (var plan in plans)
                                    {
                                        <option value="@plan.Id">@plan.Name — @Dukan.Web.Application.Display.DurationDisplay.Format(plan.Duration, plan.DurationUnit)@(plan.Price == 0 || plan.IsTrial ? " (مجاني)" : $" — {plan.Price.ToString("0.##")} {plan.Currency}")</option>
                                    }
                                </select>
                                <span asp-validation-for="PlanId" class="field-validation-error"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="Notes" class="form-label">ملاحظات</label>
                                <textarea asp-for="Notes" class="form-control" rows="3" placeholder="اكتب أي تفاصيل إضافية (اختياري)"></textarea>
                                <span asp-validation-for="Notes" class="field-validation-error"></span>
                            </div>

                            <div class="d-grid">
                                <button type="submit" class="btn btn-primary btn-lg">إرسال الطلب</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- What happens after (left in RTL) -->
            <div class="col-12 col-lg-6">
                <p class="section-kicker text-center">بعد ما تبعت</p>
                <h2 class="section-title text-center" id="how-title">شو بصير بعد ما تبعت؟</h2>
                <p class="section-sub mx-auto text-center mb-4">من رسالتك لحد ما تصير بتشتغل — أربع خطوات بسيطة.</p>

                <div class="row g-3">
                    <div class="col-sm-6">
                        <article class="step-card">
                            <div class="step-card-top">
                                <span class="step-number">1</span>
                                <span class="step-icon"><i class="bi bi-headset" aria-hidden="true"></i></span>
                            </div>
                            <h3>بنتصل فيك خلال ٢٤ ساعة</h3>
                            <p>نفهم شغل محلك وكم جهاز عندك.</p>
                        </article>
                    </div>
                    <div class="col-sm-6">
                        <article class="step-card">
                            <div class="step-card-top">
                                <span class="step-number">2</span>
                                <span class="step-icon"><i class="bi bi-tools" aria-hidden="true"></i></span>
                            </div>
                            <h3>بنركّب النظام</h3>
                            <p>بندخّل أصنافك وديون زبائنك من دفترك.</p>
                        </article>
                    </div>
                    <div class="col-sm-6">
                        <article class="step-card">
                            <div class="step-card-top">
                                <span class="step-number">3</span>
                                <span class="step-icon"><i class="bi bi-mortarboard" aria-hidden="true"></i></span>
                            </div>
                            <h3>بندرّبك أنت وعمّالك</h3>
                            <p>نص ساعة بتكفي، البرنامج بسيط.</p>
                        </article>
                    </div>
                    <div class="col-sm-6">
                        <article class="step-card">
                            <div class="step-card-top">
                                <span class="step-number">4</span>
                                <span class="step-icon"><i class="bi bi-rocket-takeoff" aria-hidden="true"></i></span>
                            </div>
                            <h3>بتشتغل</h3>
                            <p>وبنضلّ معك للدعم طول فترة اشتراكك.</p>
                        </article>
                    </div>
                </div>

                <p class="step-call">
                    <i class="bi bi-telephone" aria-hidden="true"></i>
