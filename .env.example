# Dukkan — Environment template
# Copy to .env and set strong secrets before `docker compose up -d`

# Database (SQL Server 2022)
SA_PASSWORD=YourStrong!Passw0rd
# Use a strong password: 8+ chars, upper/lower/digit/symbol
# Example: SA_PASSWORD=Dukan@2025!Strong

# Admin seed (created on first run if DB empty)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@dukan.local
ADMIN_PASSWORD=Admin@123456
# Change immediately after first login!

# Contact
CONTACT_PHONE=+972597417181
CONTACT_WHATSAPP=+972597417181

# Firebase (optional global fallback — per-subscription DB is preferred)
FIREBASE_ENABLED=true

# Ports (host:container)
WEB_PORT=5000
DB_PORT=1433
